# Copy to .env — every value is optional.

PORT=5001

# Leave empty to run against an in-memory MongoDB (zero setup, data resets on restart).
# Set to use a real database, e.g. mongodb://127.0.0.1:27017/relay or an Atlas URI.
MONGODB_URI=

# Seed demo riders/jobs when the database is empty (default: false)
SEED_ON_START=false

# Minutes a rider has to confirm an assignment (default 120 = two hours).
# Fractions are allowed (0.5 = 30 seconds). Also changeable at runtime from the UI.
ASSIGNMENT_TIMEOUT_MINUTES=120

# Auto-assign the top-ranked rider as soon as a job becomes ready (default: false)
AUTO_DISPATCH=false

# How often the background sweeper looks for expired assignments
SWEEP_INTERVAL_MS=5000

# Demo helpers: simulated clock, sweep-now, reset-demo (default: true outside production)
ENABLE_DEMO_ENDPOINTS=true

# Allowed browser origin for the API (the Vite dev server by default)
CORS_ORIGIN=http://localhost:5173
